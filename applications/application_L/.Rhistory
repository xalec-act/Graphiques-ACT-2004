rm(list = ls())
## Définir les variables
lam1 <- 5
lam2 <- 10
gam0 <- 3
lamm1 <- lam1
lamm2 <- lam2
## Pour comonotones
fm1m2como <- function(m1, m2)
{
pmin(ppois(m1, lamm1), ppois(m2, lamm2)) -
pmin(ppois(m1 - 1, lamm1), ppois(m2, lamm2)) -
pmin(ppois(m1, lamm1), ppois(m2 - 1, lamm2)) +
pmin(ppois(m1 - 1, lamm1), ppois(m2 - 1, lamm2))
}
fNcomo <- function(k) sum(sapply(0:k, function(x) fm1m2como(x, k - x)))
k <- c(seq(from = 0, to = 20, by = 5), seq(from = 30, to = 50, by = 10))
x <- 0:100
slcomo <- function(d)
{
sum(pmax(x-d, 0) * sapply(x, function(y) fNcomo(y)))
}
res1 <- cbind("k" = k, "sl+" = zapsmall(sapply(k, function(y) slcomo(y)), digits = 6))
res1
## Pour antimonotone
fm1m2anti <- function(m1, m2)
{
pmax(sum(ppois(m1, lamm1), ppois(m2, lamm2), - 1), 0) -
pmax(sum(ppois(m1 - 1, lamm1), ppois(m2, lamm2), - 1), 0) -
pmax(sum(ppois(m1, lamm1), ppois(m2 -1, lamm2), - 1), 0) +
pmax(sum(ppois(m1 -1, lamm1), ppois(m2 -1, lamm2), - 1), 0)
}
fNanti <- function(k) sum(sapply(0:k, function(x) fm1m2anti(x, k - x)))
slanti <- function(d)
{
sum(pmax(x-d, 0) * sapply(x, function(y) fNanti(y)))
}
res2 <- cbind("k" = k, "sl-" = zapsmall(sapply(k, function(y) slanti(y)), digits = 6))
res2
## Pour gam0 = 3
nfft <- 2^12
lamn <- lam1 + lam2 - gam0
fc <- c(0, (15-(2*gam0))/(15 - gam0), gam0/(15-gam0), rep.int(0, times = nfft-3))
phic <- fft(fc)
phiN <- exp(lamn * (phic - 1))
fN <- Re(fft(phiN, inverse = TRUE))/nfft
