## Définir les variables
n <- c(10, 50, 100)
al <- 1.4
lam <- 100 * (al - 1)
x <- c(1, 10, 100, 300, 500, 700, 900, 1000, 1500)
ppareto <- function(x)
{
1 - (lam/(lam + x))^al
}
res1 <- cbind(x, sapply(x, function(y) ppareto(y)))
res1
