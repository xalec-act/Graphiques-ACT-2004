rm(list = ls())
## Définir les variables
nfft <- 2^12
fx1 <- numeric(nfft)
fx2 <- numeric(nfft)
fx1[1:7] <- c(0.6, sapply(1:6, function(x) 0.4 * ((x/6)^2 - ((x-1)/6)^2)))
fx2[1:10] <- c(0.7, sapply(1:9, function(x) 0.3 * ((x/9)^3 - ((x-1)/9)^3)))
## Question 1
phix1 <- fft(fx1)
phix2 <- fft(fx2)
phis <- phix1 * phix2
fs <- Re(fft(phis, inverse = TRUE))/nfft
fs[1:16]
## Question 2
allox1 <- Re(fft(fft(0:(nfft-1) * fx1) * phix2, inverse = TRUE))/nfft
zapsmall(allox1[1:16])
allox2 <- Re(fft(fft(0:(nfft-1) * fx2) * phix1, inverse = TRUE))/nfft
zapsmall(allox2[1:16])
resfin <- zapsmall(cbind("fs" = fs, "allox1" = allox1, "espcondx1" = allox1/fs)[1:16, ])
resfin
