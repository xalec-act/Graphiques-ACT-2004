N <- 0:(nfft - 1)
qj = c(0.37000, 0.45680, 0.35066, 0.43129, 0.58995, 0.45996, 0.39875, 0.49747,
0.55592, 0.34118, 0.39109, 0.48428, 0.54470, 0.42316, 0.52717, 0.32523,
0.38659, 0.53341, 0.52859)
matvide <- matrix(0, nrow = nfft, ncol = n)
## Question 1
fni <- matvide
for (i in 1:n)
{
fni[1, i] <- (1- qj[i])
fni[2, i] <- qj[i]
}
phini <- mvfft(fni)
phiN <- sapply(1:nfft, function(x) prod(phini[x, ]))
fN <- zapsmall(Re(fft(phiN, inverse = TRUE))/nfft)
FN <- cumsum(fN)
k <- 1:20
res1 <- zapsmall(cbind("k" = k-1, "fN" = fN[k], "FN" = FN[k]), digits = 6)
res1
## Question 2
FNcom <- c(1 - sort(qj, decreasing = TRUE), 1)
fNcom <- c(FNcom[1], FNcom[-1] - FNcom[-20])
res2 <- zapsmall(cbind("k" = k-1, "fNcom" = fNcom[k], "FNcom" = FNcom[k]), digits = 6)
res2
