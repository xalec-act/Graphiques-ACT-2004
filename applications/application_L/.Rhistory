rm(list = ls())
## Définir les variables.
n <- 10
nfft <- 2^15-1
j <- 1:n
xj <- j - 10 * floor((j-1)/10)
espbj <- 50*j - 350 * floor((j-1)/7)
sij <- 0.1 * floor((j-1)/10) + 0.1
a <- -3.5
b <- 0.2
qj <- exp(a + b * xj)/(1 +  exp(a + b * xj))
muj <- log(espbj) - sij^2/2
h <- 1
## Calculer E[S] et sqrt(Var(S)).
esps <- sum(qj * espbj)
esps
vars <- sum(qj * exp(2 * muj + sij^2)* (exp(sij^2)- 1)) + sum(qj * (1 - qj) * espbj^2)
sqrt(vars)
## Calculer l'approximation FFT.
fbj <- matrix(0, ncol = n, nrow = nfft + 1)
for (i in j)
{
fbj[-1, i] <- plnorm((1:nfft) * h, muj[i], sij[i]) - plnorm(((1:nfft)-1) * h, muj[i], sij[i])
}
phib <- mvfft(fbj)
phix <- matrix(0, ncol = n, nrow = nfft + 1)
for (i in j)
{
phix[, i] <- qj[i] * phib[, i] + 1 - qj[i]
}
phis <- sapply(1:(nfft + 1), function(x) prod(phix[x, ]))
fs <- Re(fft(phis, inverse = TRUE))/(nfft+1)
kverif <- c(0, 100, 200, 300) + 1
cbind(kverif-1, fs[kverif])
kap <- c(0.9, 0.99, 0.999)
Fs <- cumsum(fs)
VaR <- function(k)
{
min(which(Fs > k)) - 1
}
sl <- function(d)
{
sum(pmax(0:nfft - d, 0) * fs)
}
TVaR <- function(k)
{
VaR(k) + (1/(1-k)) * sl(VaR(k))
}
resfft <- cbind(kap, "VaR" = sapply(kap, function(x) VaR(x)), "TVaR" = sapply(kap, function(x) TVaR(x)))
## Calculer par simulation MC.
m <- 1000000
set.seed(2026)
matsim <- matrix(runif( 2 * n * m), ncol = 2 * n, nrow = m, byrow = TRUE)
Isim <- matrix(0, ncol = n, nrow = m)
Bsim <- matrix(0, ncol = n, nrow = m)
for (i in j)
{
Isim[, i] <- qbinom(matsim[, i], 1, qj[i])
}
for (i in j)
{
Bsim[, i] <- qlnorm(matsim[, i+10], muj[i], sij[i])
}
Xsim <- Isim * Bsim
Ssim <- rowSums(Xsim)
mean(Ssim)
Fs_mc <- ecdf(Ssim)
VaR_mc <- function(k)
{
if (k < Fs_mc(0))
{
return(0)
}
else
{
optimize(function(x) abs(Fs_mc(x) - k), c(0, 1000))$min
}
}
sl_mc <- function(d)
{
mean(pmax(Ssim - d, 0))
}
TVaR_mc <- function(k)
{
VaR_mc(k) + (1/(1-k)) * sl_mc(VaR_mc(k))
}
resmc <- cbind(kap, "VaR" = sapply(kap, function(x) VaR_mc(x)), "TVaR" = sapply(kap, function(x) TVaR_mc(x)))
resmc
list("FFT" = resfft, "MC" = resmc)
