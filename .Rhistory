fNanti <- function(k) sum(sapply(0:k, function(x) fm1m2anti(x, k - x)))
slanti <- function(d)
{
sum(pmax(x-d, 0) * sapply(x, function(y) fNanti(y)))
}
res2 <- cbind("k" = k, "sl-" = zapsmall(sapply(k, function(y) slanti(y)), digits = 6))
res2
## Pour gam0 = 3
nfft <- 2^12
lamn <- lam1 + lam2 - gam0
fc <- c(0, (15-(2*gam0))/(15 - gam0), gam0/(15-gam0), rep.int(0, times = nfft-3))
phic <- fft(fc)
phiN <- exp(lamn * (phic - 1))
fN <- Re(fft(phiN, inverse = TRUE))/nfft
